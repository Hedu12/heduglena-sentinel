# NOTE: never ignore /.kiro or any of its sub-folders. The Kiroween rules require
# the .kiro directory (specs, steering, hooks) to be committed.

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
.ssh/
secrets/
credentials.json
service-account*.json

# ── Local model files (never committed; pulled by the operator) ───────────────
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
.ollama/

# ── Generated evaluation reports ──────────────────────────────────────────────
# Benchmark output (reports/phase8.x/, including raw model text in debug/) is
# regenerated by `python -m evaluation`. Hand-written planning documents are kept.
reports/*
!reports/phase8.5/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
.vennv/
venv/
env/
ENV/
.Python
pip-wheel-metadata/
*.whl

# Type checking / linting caches
.mypy_cache/
.ruff_cache/
.dmypy.json

# Test / coverage
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml
.tox/
.nox/

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
# Demo-session archives written by POST /api/v1/demo/reset (local data, never committed)
*-demo-sessions/
*.sqlite
*.sqlite3

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.local

# Playwright
test-results/
playwright-report/
playwright/.cache/

# ── IDEs and editors ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
# (compose.override files may contain local secrets)
docker-compose.override.yml

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
