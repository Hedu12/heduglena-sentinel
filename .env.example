# HEDUGLENA Sentinel — Environment Configuration
# Copy this file to .env and edit as needed.
# NEVER commit .env to source control.

# ── Application ──────────────────────────────────────────────────────────────

# Enable demo injection endpoints (POST /api/v1/demo/*).
# Set to false in any production or sensitive environment.
DEMO_MODE=true

# Reserved for future live protective actions. None are implemented: ResponseGuard
# blocks them unless this is true, and even then the executor has no live handler,
# so every action stays SIMULATED. Setting this to true logs a prominent WARNING.
LIVE_ACTIONS=false

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# The frontend origin: the only origin allowed by CORS and by WS /ws/live.
FRONTEND_ORIGIN=http://localhost:3000

# ── Telemetry ─────────────────────────────────────────────────────────────────

# How often to collect host metrics (seconds). Minimum recommended: 0.25
POLL_INTERVAL_SECONDS=2

# ── Runtime: demo scenarios and the live stream ───────────────────────────────

# Pause between the synthetic events of a demo scenario (seconds, 0-10).
DEMO_STEP_INTERVAL_SECONDS=1
# Demo requests (inject + scenario) accepted per rolling minute.
DEMO_MAX_REQUESTS_PER_MINUTE=30
# WebSocket /ws/live: maximum concurrent clients and messages buffered per client.
LIVE_MAX_SUBSCRIBERS=8
LIVE_QUEUE_SIZE=200

# ── Threat Scoring ────────────────────────────────────────────────────────────

# ── Defense State Machine ─────────────────────────────────────────────────────

# Seconds a score must remain above a threshold before ascending one state.
DWELL_SECONDS=10

# Minimum seconds before the state can descend one level.
COOLDOWN_SECONDS=30

# Score thresholds for each state boundary.
THRESHOLD_RELAXED_ALERT=0.25
THRESHOLD_ALERT_DEFENSIVE=0.55
THRESHOLD_DEFENSIVE_AGGRESSIVE=0.80

# ── Database ──────────────────────────────────────────────────────────────────

# SQLAlchemy async connection string.
# For PostgreSQL: postgresql+asyncpg://user:password@host:5432/sentinel
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# ── AI Provider ───────────────────────────────────────────────────────────────

# Which AI adapter to use: null | ollama | openai
# "null" returns deterministic fallback text with no network calls.
# "ollama" uses a local Ollama instance (recommended for hackathon).
# "openai" requires OPENAI_API_KEY.
AI_PROVIDER=null

# Ollama settings (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI-compatible settings (used when AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Maximum characters of any single explanation field (AIOutputValidator cap).
AI_MAX_RESPONSE_CHARS=2000

# ── AI explanation layer (Phase 6) ────────────────────────────────────────────
# Explanation-only: these never affect scoring, state, or response actions.
# Raw provider output above this size is rejected before parsing.
AI_MAX_RAW_RESPONSE_CHARS=8000
# Prompt context (JSON) above this size is not sent.
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=500
# Per-call timeout and bounded attempts (timeouts/provider errors only).
AI_EXPLANATION_TIMEOUT_SECONDS=10
AI_MAX_ATTEMPTS=2
AI_MAX_CONTEXT_EVENTS=10
AI_MAX_CONTEXT_TRANSITIONS=8
AI_MAX_CONTEXT_ACTIONS=10
# Explanation refresh interval while AGGRESSIVE (minimum 10).
AI_AGGRESSIVE_REFRESH_SECONDS=30
# Score rise since the last explanation that counts as significant new evidence.
AI_EVIDENCE_SCORE_DELTA=0.15
AI_QUEUE_MAX_INCIDENTS=32

# ── Detection Rule Overrides ──────────────────────────────────────────────────
# Default thresholds are defined in backend/detection/rules.py.
# Override individual rule thresholds here without changing code.

# Auth failure burst: max failures within the window
RULE_AUTH_FAILURE_COUNT=5
RULE_AUTH_FAILURE_WINDOW_SECONDS=60

# ── Detection engine (Phase 3) ────────────────────────────────────────────────
# Minimum seconds between repeat events from the same rule (debounce).
DET_COOLDOWN_SECONDS=60

# DET-CPU-001 / DET-MEM-001: sustained utilisation.
DET_CPU_THRESHOLD_PERCENT=90
DET_CPU_CONSECUTIVE_SAMPLES=3
DET_MEM_THRESHOLD_PERCENT=90
DET_MEM_CONSECUTIVE_SAMPLES=3

# DET-NET-001: per-direction throughput threshold (bytes per second).
DET_NET_THRESHOLD_BYTES_PER_SECOND=50000000
DET_NET_CONSECUTIVE_SAMPLES=3

# DET-PROC-001: process-count deviation from a rolling baseline.
DET_PROC_WINDOW_SAMPLES=30
DET_PROC_MIN_BASELINE_SAMPLES=10
DET_PROC_INCREASE_RATIO=1.5
DET_PROC_MIN_INCREASE=50
DET_PROC_CONSECUTIVE_SAMPLES=2

# DET-SYN-001: synthetic security events (auth failures use RULE_AUTH_FAILURE_*).
DET_ACCESS_DENIED_COUNT=5
DET_ACCESS_DENIED_WINDOW_SECONDS=60
DET_CONNECTION_BURST_COUNT=20
DET_CONNECTION_BURST_WINDOW_SECONDS=30

# ── Threat scoring (Phase 4) ──────────────────────────────────────────────────
# Weights: each term of the score is bounded by its weight.
THREAT_WEIGHT_SEVERITY=0.45
THREAT_WEIGHT_CONFIDENCE=0.15
THREAT_WEIGHT_REPETITION=0.10
THREAT_WEIGHT_ESCALATION=0.10
THREAT_WEIGHT_CORRELATION=0.20
THREAT_WEIGHT_CROSS_DOMAIN=0.10
THREAT_CORRELATION_PER_CATEGORY=0.15
# Severity -> risk level (non-decreasing).
THREAT_LEVEL_INFO=0.10
THREAT_LEVEL_LOW=0.20
THREAT_LEVEL_MEDIUM=0.40
THREAT_LEVEL_HIGH=0.70
THREAT_LEVEL_CRITICAL=1.00
THREAT_REPETITION_SCALE=3.0
THREAT_REPETITION_CAP=100
# Evidence halves in weight every half-life and is dropped after the TTL.
THREAT_HALF_LIFE_SECONDS=60
THREAT_EVIDENCE_TTL_SECONDS=300
THREAT_ACTIVE_WINDOW_SECONDS=60
THREAT_MAX_SIGNALS=64
THREAT_DEDUP_WINDOW=1024
THREAT_DEFAULT_CONFIDENCE=0.5
THREAT_SCORE_PERSIST_MIN_DELTA=0.01

# ── Defense state machine (Phase 4) ───────────────────────────────────────────
# Entry thresholds are THRESHOLD_* above; dwell/cooldown are DWELL_SECONDS and
# COOLDOWN_SECONDS. A state is left when the score falls HYSTERESIS_MARGIN
# below its entry threshold.
THREAT_HYSTERESIS_MARGIN=0.05
THREAT_ESCALATION_BYPASS_MARGIN=0.10
THREAT_FLOOR_CRITICAL=DEFENSIVE
THREAT_FLOOR_HIGH=ALERT
# The bypass into AGGRESSIVE also needs this many independent signal categories,
# each at least this strong. Floors may not be AGGRESSIVE.
THREAT_AGGRESSIVE_MIN_CATEGORIES=2
THREAT_CORROBORATION_MIN_STRENGTH=0.15
# A new escalation this soon after the last one ended continues the same situation
# (no second RECORD_INCIDENT recommendation).
THREAT_INCIDENT_REOPEN_SECONDS=300

# ── Response engine (Phase 5) ─────────────────────────────────────────────────
# All response actions are SIMULATED in this phase, whatever LIVE_ACTIONS says.
# Cooldowns use decision timestamps, not the wall clock.
RESPONSE_RETRY_COOLDOWN_SECONDS=30
RESPONSE_ALERT_COOLDOWN_SECONDS=60
